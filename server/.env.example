# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas — replace <user>, <password>, <cluster-url>, and db name
# Get this from Atlas: Database > Connect > Drivers > Node.js
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/rakshak?retryWrites=true&w=majority

# JWT (Step 5)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# AI provider (Step 8) — "ollama" or "openai"
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Log template mining (Drain3 microservice, log-template-service/) — optional
LOG_TEMPLATE_SERVICE_URL=http://localhost:8001
LOG_TEMPLATE_SERVICE_ENABLED=true
